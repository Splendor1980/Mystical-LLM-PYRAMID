<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mystica" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>

    <style name="BubbleUser">
        <item name="android:background">@drawable/bg_bubble_user</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="BubbleBot">
        <item name="android:background">@drawable/bg_bubble_bot</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>